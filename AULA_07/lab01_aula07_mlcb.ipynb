import re
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.linear_model import LogisticRegression
from sklearn.pipeline import Pipeline

dados_treino = [
    ("Onde está meu pedido?", "rastrear_pedido"),
    ("Quero acompanhar o rastreamento da minha encomenda", "rastrear_pedido"),
    ("Qual é o código de rastreio do meu pedido?", "rastrear_pedido"),
    ("Como posso rastrear minha compra?", "rastrear_pedido"),
    ("Quero saber onde está minha encomenda", "rastrear_pedido"),
    ("Meu pedido já foi enviado?", "rastrear_pedido"),
    ("Tem como ver por onde está meu pedido?", "rastrear_pedido"),

    ("Quero cancelar minha compra", "cancelar_compra"),
    ("Preciso cancelar o pedido que fiz", "cancelar_compra"),
    ("Como faço para cancelar meu pedido?", "cancelar_compra"),
    ("Quero desistir da compra e cancelar o pedido", "cancelar_compra"),
    ("Preciso cancelar uma compra que fiz hoje", "cancelar_compra"),
    ("É possível cancelar meu pedido?", "cancelar_compra"),

    ("Quero pedir reembolso da minha compra", "pedir_reembolso"),
    ("Como faço para receber meu dinheiro de volta?", "pedir_reembolso"),
    ("Quero meu dinheiro de volta", "pedir_reembolso"),
    ("Preciso solicitar um reembolso", "pedir_reembolso"),
    ("Como funciona o processo de reembolso?", "pedir_reembolso"),
    ("Quero receber o valor que paguei de volta", "pedir_reembolso")
]

stopwords = [
    "onde", "quero", "o", "é", "preciso", "um", "possivel",
    "uma", "de", "da", "como", "que", "já", "meu",
    "minha", "tem", "ver", "por", "e"
]

# 1. PRÉ-PROCESSAMENTO
def pre_processar(texto):
    texto = texto.lower()

    # remove caracteres especiais
    texto_limpo = re.sub(r'[^a-zà-ú0-9\s]', '', texto)

    tokens = texto_limpo.split()

    # TODO 1.1
    tokens_filtrados = [
        token for token in tokens
        if token not in stopwords
    ]

    return " ".join(tokens_filtrados)

X_treino_limpo = [pre_processar(item[0]) for item in dados_treino]
y_treino = [item[1] for item in dados_treino]

# 2. PIPELINE
pipeline_tf = Pipeline([
    ("vectorizer", TfidfVectorizer()),
    ("classifier", LogisticRegression())
])

# TODO 1.2
pipeline_tf.fit(X_treino_limpo, y_treino)

# extraindo componentes
vectorizer = pipeline_tf.named_steps["vectorizer"]
modelo = pipeline_tf.named_steps["classifier"]

# 3. EXTRAÇÃO DE ENTIDADES
def extrair_valor_reais(texto_original):
    match = re.search(r'(\d+)\s*reais', texto_original, re.IGNORECASE)

    # TODO 1.3
    if match:
        return float(match.group(1))
    else:
        return None

# 4. NLU
def processar_nlu(mensagem_usuario, threshold=0.55):

    texto_p = pre_processar(mensagem_usuario)

    vetor_input = vectorizer.transform([texto_p])

    probas = modelo.predict_proba(vetor_input)[0]

    # TODO 1.4
    maior_confianca = max(probas)
    intencao_prevista = modelo.classes_[probas.argmax()]

    valor = extrair_valor_reais(mensagem_usuario)

    # TODO 1.5
    if maior_confianca < threshold:
        return "FALLBACK"

    else:
        return {
            "status": "SUCESSO",
            "intencao": intencao_prevista,
            "confianca": round(maior_confianca, 2),
            "valor_extraido": valor
        }

# TESTES
print(processar_nlu("Quero cancelar minha compra"))

print(processar_nlu("Preciso de reembolso de 500 reais"))

print(processar_nlu("Onde está meu pedido?"))

print(processar_nlu("Qual a previsão do tempo?"))
