import io
import re
import numpy as np
import pandas as pd
import spacy

from gensim.models import FastText
from google.colab import files




print("=" * 60)
print("CARREGANDO MODELO DE LÍNGUA PORTUGUESA")
print("=" * 60)

nlp = spacy.load("pt_core_news_sm")

print("Modelo carregado com sucesso!")



def limpar_e_lemmatizar(texto):
    """
    Realiza a normalização e lematização de uma mensagem.
    """


    texto = str(texto)


    texto = texto.lower()


    texto = re.sub(r"http\S+|www\S+", "", texto)


    texto = re.sub(r"\d+", "", texto)


    texto = re.sub(
        r"[^a-záàâãéèêíïóôõöúçñ\s]",
        " ",
        texto
    )


    texto = re.sub(r"\s+", " ", texto).strip()


    doc = nlp(texto)


    palavras = []

    for token in doc:

        if not token.is_space and not token.is_punct:

            lema = token.lemma_.strip()

            if lema:
                palavras.append(lema)


    return " ".join(palavras)




print("\n" + "=" * 60)
print("TESTE DA FUNÇÃO DE LIMPEZA")
print("=" * 60)

frase_exemplo = "Quero devolver meu sofá!"

print("Original:")
print(frase_exemplo)

print("\nProcessada:")
print(limpar_e_lemmatizar(frase_exemplo))



print("\n" + "=" * 60)
