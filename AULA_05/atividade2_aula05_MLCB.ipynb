corpus_tokenizado = df["tokens"].tolist()

# Remover eventuais listas vazias
corpus_tokenizado = [
    tokens
    for tokens in corpus_tokenizado
    if len(tokens) > 0
]

if len(corpus_tokenizado) == 0:
    raise ValueError(
        "Nenhum token foi encontrado no dataset."
    )


print("\n" + "=" * 60)
print("CORPUS TOKENIZADO")
print("=" * 60)

print("\nPrimeiros exemplos:")

for exemplo in corpus_tokenizado[:5]:
    print(exemplo)


print("\n" + "=" * 60)
print("TREINANDO MODELO FASTTEXT")
print("=" * 60)

modelo_fasttext = FastText(
    sentences=corpus_tokenizado,
    vector_size=50,
    window=3,
    min_count=1,
    workers=4,
    sg=1
)

print("\nModelo FastText treinado com sucesso!")

print(
    "Dimensão dos vetores:",
    modelo_fasttext.vector_size
)

print(
    "Quantidade de palavras no vocabulário:",
    len(modelo_fasttext.wv.index_to_key)
)




def obter_vetor_frase(frase, modelo):
    """
    Transforma uma frase em um vetor denso utilizando
    FastText + Mean Pooling.
    """


    frase = str(frase)

 
    palavras = frase.split()


    vetores = []

    for palavra in palavras:


        vetor = modelo.wv[palavra]


        vetores.append(vetor)

 
    if len(vetores) == 0:

        return np.zeros(
            modelo.vector_size,
            dtype=np.float32
        )


    vetor_medio = np.mean(
        vetores,
        axis=0
    )

    return vetor_medio


print("\n" + "=" * 60)
print("GERANDO REPRESENTAÇÕES VETORIAIS")
print("=" * 60)

